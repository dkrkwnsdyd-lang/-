# SHOP SHORTS V2 - 서버 전용 환경변수. 이 파일을 .env 로 복사해서 값을 넣으세요.
# .env 는 .gitignore 에 포함되어 git 에 올라가지 않습니다. 키를 프론트엔드/로그에 넣지 마세요.

# LLM / Vision (기획, 대본, QA) - 없으면 규칙 기반 디렉터로 동작
# 클라우드 세션에서는 이 파일 대신 '환경 자격 증명(API credentials)'에 넣어도 된다:
#   허용 웹사이트 generativelanguage.googleapis.com, 헤더 이름 x-goog-api-key, 접두사 없음, 값 = 키
#   (코드가 프록시 주입을 자동 감지한다. 로컬 PC 에서는 아래에 직접 입력)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=

# TTS (보이스오버) - 없으면 자막+음악 버전
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# B-roll (스톡 영상)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# 영상 생성 (adapter 는 공식 문서 검증 후 활성화 - model_registry.yaml 의 enabled)
SEEDANCE_API_KEY=
HIGGSFIELD_API_KEY=

# 업로드 (기존 기능)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=
THREADS_ACCESS_TOKEN=
THREADS_USER_ID=
TIKTOK_ACCESS_TOKEN=
PUBLIC_BASE_URL=
